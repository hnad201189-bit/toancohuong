# Sao chép file này thành ".env" (cùng thư mục server/) rồi điền giá trị thật.
# .env không được commit vào git (đã có trong .gitignore).

# Bắt buộc để dùng tính năng "Chụp ảnh giải bài". Lấy tại console.anthropic.com
ANTHROPIC_API_KEY=

# Tuỳ chọn — model dùng để giải bài từ ảnh (mặc định: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Tuỳ chọn — mật khẩu trang quản trị (mặc định: admin123)
ADMIN_PASSWORD=admin123
